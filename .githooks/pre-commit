#!/usr/bin/env bash
#
# 提交前跑静态闸门（.trae/rules.md §15）：格式是构建闸门，要在代码进历史前拦掉。
#
# 只在暂存区有 .kt/.kts 时跑——改个文档也全量构建只会逼人用 --no-verify。两个产品都查：客户端
# 刚起步时最容易漏的就是「另一端还没接闸门」，等想起来就已经欠了一堆格式债。测试与打包分别交给
# scripts/build-burp-extension.sh 与 scripts/build-mobile-app.sh。
#
# 这里显式把 JDK 17 交给 Gradle：AGP 跑在机器默认的 JDK 25 上会报出指向无关位置的错。

set -euo pipefail

readonly repository_root_directory="$(git rev-parse --show-toplevel)"
readonly extension_project_directory="${repository_root_directory}/plugins"
readonly mobileapp_project_directory="${repository_root_directory}/client/mobileapp"

if ! git diff --cached --name-only | grep -Eq '\.kts?$'; then
    exit 0
fi

source "${repository_root_directory}/scripts/lib/resolve-java-home.sh"

resolved_java_home="$(locateJavaHomeForVersion 17 || true)"
if [[ -n "${resolved_java_home}" ]]; then
    export JAVA_HOME="${resolved_java_home}"
fi

run_static_gates() {
    local project_directory="$1"
    local project_label="$2"
    shift 2

    if [[ ! -x "${project_directory}/gradlew" ]]; then
        printf '跳过 %s 的静态闸门：找不到可执行的 gradlew。\n' "${project_label}" >&2
        return 0
    fi

    printf '运行 %s 的静态闸门：%s\n' "${project_label}" "$*"

    if ! "${project_directory}/gradlew" \
        --project-dir "${project_directory}" \
        --console=plain \
        --quiet \
        "$@"; then
        printf '\n提交被拒绝：%s 的静态闸门未通过。\n' "${project_label}" >&2
        printf '修正后重新暂存再提交；确认只是环境问题可用 git commit --no-verify。\n' >&2
        exit 1
    fi
}

run_static_gates "${extension_project_directory}" "插件" ktlintCheck detekt
run_static_gates "${mobileapp_project_directory}" "客户端" ktlintCheck

printf '静态闸门通过。\n'
