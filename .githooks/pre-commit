#!/usr/bin/env bash
#
# Burp Remote —— Git 钩子 / 提交前静态闸门。
#
# 依据 .trae/rules.md §15「Formatting and enforcement」在提交前运行静态闸门：
#
#   ./gradlew ktlintCheck detekt
#
# §15 的原话是「格式永远不是评审意见，而是构建闸门」。既然它是闸门，最合适的位置就是在
# 代码进入历史之前——不合规的代码一旦提交，后面每个读历史的人都要多绕一次。
#
# 范围上的两个自觉取舍：
#
#   1. 暂存区里没有 Kotlin 源码或 Gradle 脚本时直接跳过。改文档、改资源也跑一遍完整构建，
#      只会让人开始用 --no-verify。
#   2. 不跑单元测试与打包。那两件事由 scripts/build-burp-extension.sh 在推送前承担；
#      测试要等编译，而「一个改动一次提交」的节奏恰恰要求提交足够快。
#
# 钩子不自己解析 JDK：工具链版本由 Gradle 的 jvmToolchain 声明并自动定位。若本机找不到
# JDK 17 而构建失败，请把 JAVA_HOME 指向它，或改用 scripts/build-burp-extension.sh 指定的
# 环境变量方式（两者最终都是让 Gradle 用上 17）。
#
# 安装：见 scripts/install-githooks.sh。
#
# @author 钟智强

set -euo pipefail

readonly repository_root_directory="$(git rev-parse --show-toplevel)"
readonly gradle_project_directory="${repository_root_directory}/plugins"

if ! git diff --cached --name-only | grep -Eq '\.kts?$'; then
    exit 0
fi

if [[ ! -x "${gradle_project_directory}/gradlew" ]]; then
    printf '跳过静态闸门：找不到可执行的 plugins/gradlew。\n' >&2
    exit 0
fi

printf '运行静态闸门：ktlintCheck detekt\n'

if ! "${gradle_project_directory}/gradlew" \
    --project-dir "${gradle_project_directory}" \
    --console=plain \
    --quiet \
    ktlintCheck detekt; then
    printf '\n提交被拒绝：静态闸门未通过。\n' >&2
    printf '修正后请重新暂存改动并再次提交；确认只是环境问题时可使用 git commit --no-verify。\n' >&2
    exit 1
fi

printf '静态闸门通过。\n'
