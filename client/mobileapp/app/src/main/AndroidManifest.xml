<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 远程控制走局域网上的 REST 与 WebSocket，没有这个权限连不上插件。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 会话可用期间要挂一条常驻通知，因此需要一个前台服务。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      connectedDevice 类型在 Android 14 起要求声明对应的类型权限；两者都是普通权限，安装即授予。
      选这个类型而不是 dataSync：它描述的就是「通过网络连接与外部设备交互」，而且没有 dataSync
      那样的每日累计时长上限，会话该持续多久就持续多久。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!--
      connectedDevice 类型的运行时前提：下面这一组里的任意一个普通权限即可满足，安装时自动授予。
      缺了它 startForeground 会抛 SecurityException，而且是在会话刚建立那一刻才炸。
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Android 13 起通知要用户授权；拒绝时服务照常运行，只是那条通知不会显示。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RemoteControlApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.BurpsuiteRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              静态快捷入口与桌面小部件的额外参数由系统启动器（Launcher）代发，
              Launcher 是受信任的发起方，因此 MainActivity 也直接对 ACTION_MAIN 开放。
              intent-filter 只对动作与分类负责匹配；额外参数 EXTRA_START_ROUTE 在 MainActivity
              里读，并按白名单校验后才采用，不暴露任意路由能力。
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          会话可用期间的前台服务。不声明 stopWithTask：默认行为才会回调 onTaskRemoved，
          而「用户把应用划掉」这件事的收尾（断开会话）正需要那个回调。
        -->
        <service
            android:name=".ConnectionSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          桌面小部件提供者。exported 必须为 true：系统的 AppWidgetService 在另一个进程，
          要拿到它的实例必须能跨进程调起。android:label 是小部件选择器里显示的名字，
          与应用名一致即可——「桌面上多了一个 Burpsuite Remote」比「桌面上多了一个 Widget」更清楚。
        -->
        <receiver
            android:name=".BurpRemoteAppWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/burp_remote_widget_info" />
        </receiver>

        <!--
          统计小部件提供者。与连接小部件对称：exported 必须为 true，label 用带「Stats」后缀
          的名字，让用户在小部件选择器里能区分两个小部件。
        -->
        <receiver
            android:name=".BurpRemoteStatsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_stats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/burp_remote_stats_widget_info" />
        </receiver>
    </application>

</manifest>
