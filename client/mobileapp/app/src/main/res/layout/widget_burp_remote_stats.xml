<?xml version="1.0" encoding="utf-8"?>
<!--
  统计小部件布局。

  限制同 widget_burp_remote.xml：RemoteViews 只支持受控控件，Compose 在这里用不上。

  结构（自顶向下）：
    1. 顶栏：左边应用名，右边最近一条目标主机（运行时写入；没有记录时显示「No target」）。
    2. 一条 1dp 的半透明白色分隔线。
    3. 三行统计：Live / Intercepted / Saved，各自带计数。计数用等宽数字，变化时眼睛能跟上。
    4. 底栏一句「Open app」提示：整张小部件点一下进主面板。

  padding 取 12dp，与连接小部件一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_stats_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_stats_target_host"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_stats_no_target"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingStart="8dp" />
    </LinearLayout>

    <!--
      分隔线：RemoteViews 不支持普通 <View>，用一个高度 1dp、空文本的 TextView 顶替；
      它在系统看来是合法的 TextView，但只画 background 这一档。
    -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#40FFFFFF" />

    <!-- 三行统计各自左标签右计数，计数等宽，变化时眼睛能跟上。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_stats_live_label"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_stats_live_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_stats_intercepted_label"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_stats_intercepted_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_stats_saved_label"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_stats_saved_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底栏提示：整张小部件可点，开主面板。 -->
    <TextView
        android:id="@+id/widget_stats_open_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_stats_open_hint"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        android:gravity="center" />
</LinearLayout>
