<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Burpsuite Remote</string>

    <!-- 主面板顶栏的扫码动作：图标没有文字，因此这句同时是它的无障碍说明。 -->
    <string name="navigation_action_scan_pairing">Scan the pairing QR code</string>

    <!-- 分享与导出屏的标题；这一屏只有参数路由，标题归外壳那块唯一的顶栏。 -->
    <string name="navigation_title_sharing">Share and export</string>

    <!-- 弹窗容器在配对请求飞行期间说的话：那一段时间里界面必须有东西动，否则用户以为卡住了。 -->
    <string name="pairing_scanner_status_in_flight">Pairing…</string>

    <!-- 会话前台服务的常驻通知；文案要能解释「为什么这里一直挂着一条通知」。 -->
    <string name="connection_session_channel_name">Connection session</string>
    <string name="connection_session_channel_description">Shown while a session with Burp is being kept alive.</string>
    <string name="connection_session_title">Keeping the session with Burp</string>
    <string name="connection_session_disconnect_action">Disconnect</string>

    <!-- 静态快捷入口：short label 在启动器长按应用图标时显示，long label 在拖到桌面后的快捷标签下显示。 -->
    <string name="shortcut_dashboard_short">Dashboard</string>
    <string name="shortcut_dashboard_long">Open the dashboard</string>
    <string name="shortcut_history_short">History</string>
    <string name="shortcut_history_long">Open the live history</string>
    <string name="shortcut_intercept_short">Intercept</string>
    <string name="shortcut_intercept_long">Open the live intercept queue</string>
