    <string name="shortcut_connection_short">Burp connection</string>
    <string name="shortcut_connection_long">Open the Burp connection settings</string>

    <!--
      桌面小部件顶栏右侧的状态摘要：每种 ConnectionState 一段短语。
      长不超过 12 字符，否则顶栏把它截掉；短语对用户而言「越短越好读」，
      但要保留「连上 / 没连上」这一组最关键的二分状态。
    -->
    <string name="widget_status_unknown">Unknown</string>
    <string name="widget_status_offline">Offline</string>
