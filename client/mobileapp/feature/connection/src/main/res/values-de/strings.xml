    <string name="connection_scan_heading">Kopplungscode scannen</string>
    <string name="connection_scan_headline">QR-Code in den Sucher halten</string>
    <string name="connection_scan_detail">Erzeugen Sie den Code im Burp-Remote-Tab des Plug-ins und scannen Sie ihn. Der Code enthält Adresse, Port und einen einmaligen Kopplungscode und ist damit der einzige Weg, dieses Gerät zu konfigurieren.</string>
    <string name="connection_scan_action">Scanner öffnen</string>

    <string name="connection_scanner_status_searching">QR-Code wird gesucht…</string>
    <string name="connection_scanner_status_pending">Kameraberechtigung wird erwartet…</string>
    <string name="connection_scanner_status_permission_denied">Kamerazugriff ist verweigert</string>
    <string name="connection_scanner_status_undecodable">Dieser Code ist kein Kopplungsticket</string>
    <string name="connection_scanner_status_expired">Dieses Ticket ist abgelaufen</string>
    <string name="connection_scanner_status_protocol">Protokollversion passt nicht</string>
    <string name="connection_scanner_close_action">Scanner schließen</string>

    <string name="connection_scanner_mode_camera">Kamera</string>
    <string name="connection_scanner_mode_manual">Kopplungstext</string>
    <string name="connection_scanner_manual_headline">Scannen nicht möglich?</string>
    <string name="connection_scanner_manual_detail">Fügen Sie den Kopplungstext ein, den das Plug-in neben dem QR-Code anzeigt. Er durchläuft dieselbe lokale Prüfung und dieselbe Kopplungsanfrage wie ein gescannter Code.</string>

    <string name="connection_scanner_permission_denied_headline">Kamerazugriff ist verweigert</string>
    <string name="connection_scanner_permission_denied_detail">Ohne Kamera lässt sich der QR-Code nicht lesen und dieses Gerät nicht konfigurieren. Erteilen Sie die Berechtigung zum Scannen. Zeigt Android die Abfrage nicht mehr, aktivieren Sie die Kameraberechtigung für diese App in den Systemeinstellungen.</string>
    <string name="connection_scanner_permission_request_action">Kamerazugriff erlauben</string>
    <string name="connection_scanner_permission_pending_headline">Kameraberechtigung wird erwartet</string>
    <string name="connection_scanner_permission_pending_detail">Android fragt gerade nach der Kameraberechtigung. Sobald sie erteilt ist, öffnet sich hier der Sucher.</string>

    <string name="connection_ticket_heading">Kopplungsticket</string>
    <string name="connection_ticket_host_label">Host</string>
    <string name="connection_ticket_port_label">Port</string>
    <string name="connection_ticket_protocol_version_label">Protokollversion des Tickets</string>
    <string name="connection_ticket_expires_at_label">Gültig bis</string>
    <string name="connection_ticket_absent_headline">Noch kein Ticket gescannt</string>
    <string name="connection_ticket_absent_detail">Auf diesem Gerät wurde noch nichts gescannt; es gibt daher noch keine Adresse, keinen Port und keinen einmaligen Code.</string>

    <string name="connection_ticket_rejection_undecodable_headline">Dieser QR-Code ist kein Kopplungsticket</string>
    <string name="connection_ticket_rejection_undecodable_detail">Der Code wurde gelesen, sein Inhalt entspricht aber nicht dem Ticket-Vertrag. Scannen Sie den Code aus dem Burp-Remote-Tab des Plug-ins.</string>
    <string name="connection_ticket_rejection_expired_headline">Dieses Ticket ist bereits abgelaufen</string>
    <string name="connection_ticket_rejection_expired_detail">Es war bis %1$s gültig. Erzeugen Sie im Plug-in einen neuen Code und scannen Sie ihn.</string>
    <string name="connection_ticket_rejection_protocol_headline">Protokollversion nicht unterstützt</string>
    <string name="connection_ticket_rejection_protocol_detail">Das Ticket nennt Protokollversion %1$d, dieser Client spricht Version %2$d. Aktualisieren Sie die ältere Seite und erzeugen Sie einen neuen Code.</string>

    <string name="connection_manual_pairing_heading">Kopplungstext von Hand eingeben</string>
    <string name="connection_manual_pairing_headline">Rückfalloption, wenn der Code nicht scanbar ist</string>
    <string name="connection_manual_pairing_hint">Fügen Sie den Kopplungstext ein, den das Plug-in neben dem QR-Code anzeigt. Er läuft durch dieselbe Kette wie ein gescannter Code; beide Wege enden in derselben Kopplungsanfrage.</string>
    <string name="connection_manual_pairing_text_label">Kopplungstext</string>
    <string name="connection_manual_pairing_action">Koppeln</string>
    <string name="connection_pairing_text_required_hint">Fügen Sie zuerst den Kopplungstext ein</string>

    <string name="connection_pairing_result_heading">Kopplungsergebnis</string>
    <string name="connection_pairing_succeeded_headline">Das Plug-in hat dieses Gerät akzeptiert</string>
    <string name="connection_pairing_succeeded_detail">Das Credential liegt auf diesem Gerät. Die Verbindung kann nun im Hintergrund weiterlaufen.</string>
    <string name="connection_pairing_rejection_code">der Kopplungscode stimmte nicht mit dem vom Plug-in ausgegebenen überein</string>
    <string name="connection_pairing_rejection_session_expired">die Kopplungssitzung ist bereits abgelaufen; erzeugen Sie einen neuen Code</string>
    <string name="connection_pairing_rejection_session_unavailable">das Plug-in kennt diese Kopplungssitzung nicht mehr; scannen Sie einen frischen Code</string>
    <string name="connection_pairing_rejection_protocol">beide Seiten sind sich bei der Protokollversion uneinig</string>
    <string name="connection_pairing_rejection_authentication">diese Geräteidentität wurde abgelehnt</string>
    <string name="connection_pairing_rejection_unreachable">das Plug-in war nicht erreichbar; prüfen Sie Adresse, Port und ob Burp läuft</string>
    <string name="connection_pairing_rejection_not_supported">das Plug-in hat diesen Endpunkt noch nicht implementiert</string>
    <string name="connection_pairing_rejection_unknown">das Plug-in antwortete mit einem Fehler, den dieser Client nicht kennt</string>
    <string name="connection_pairing_in_flight">Kopplung läuft…</string>

    <string name="connection_unavailable_headline">Diese Aktion ist noch nicht verfügbar</string>
    <string name="connection_reason_no_transport">die entfernte Übertragungsschicht ist in diesem Build noch nicht verdrahtet</string>
    <string name="connection_reason_no_ticket">scannen Sie zuerst ein Kopplungsticket oder fügen Sie den Kopplungstext oben ein</string>
    <string name="connection_reason_ticket_unusable">das gescannte Ticket ist so nicht verwendbar; der Grund steht oben im Ticket-Abschnitt</string>

