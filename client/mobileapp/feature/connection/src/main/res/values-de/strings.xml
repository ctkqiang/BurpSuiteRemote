    <string name="connection_retry_heading">Verbindung</string>
    <string name="connection_retry_headline">Sitzung zu Burp öffnen</string>
    <string name="connection_retry_detail">Eine Verbindung hält eine Sitzung offen und schreibt Ereignisse fortlaufend ins lokale Journal. Nach einem Fehler können Sie es hier erneut versuchen.</string>
    <string name="connection_retry_action">Verbindung erneut versuchen</string>
