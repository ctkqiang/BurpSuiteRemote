    <string name="connection_reason_no_transport">the remote transport is not wired up yet in this build</string>
    <string name="connection_reason_no_ticket">scan a pairing ticket first, or paste the pairing text into the field above</string>
    <string name="connection_reason_ticket_unusable">the scanned ticket cannot be used as it stands; the reason is written above</string>

    <string name="connection_paired_heading">Paired device</string>
    <string name="connection_paired_state_paired">PAIRED</string>
    <string name="connection_paired_state_unpaired">NOT PAIRED</string>
    <string name="connection_paired_headline">Pairing is stored on this device</string>
    <string name="connection_paired_detail_paired">The address and the port below come from the scanned ticket. Pair again to replace the credential, or clear the pairing to forget this device on both sides.</string>
    <string name="connection_paired_detail_unpaired">No credential is stored yet. Scan a ticket to pair; the address and the port are written from it.</string>
    <string name="connection_paired_host_label">Paired host</string>
    <string name="connection_paired_port_label">Paired port</string>
    <string name="connection_paired_re_pair_action">Pair again</string>
    <string name="connection_paired_clear_action">Clear pairing</string>

