    <string name="connection_retry_headline">Open the session to Burp</string>
    <string name="connection_retry_detail">Connecting keeps a session open and streams events into the local journal. Pull down on the dashboard, or retry here after a failure.</string>
    <string name="connection_retry_action">Retry connection</string>
    <string name="connection_retry_disabled_hint">Save an address and a port first</string>
