    <string name="connection_scanner_mode_camera">Camera</string>
    <string name="connection_scanner_mode_manual">Pairing text</string>
    <string name="connection_scanner_manual_headline">Scanning is not an option?</string>
    <string name="connection_scanner_manual_detail">Paste the pairing text the extension shows next to the QR code. It goes through exactly the same validation and the same pairing request as a scanned code.</string>

    <string name="connection_scanner_permission_denied_headline">Camera access is denied</string>
    <string name="connection_scanner_permission_denied_detail">Without the camera the QR code cannot be read, and this device cannot be configured. Grant the permission to scan. If Android no longer shows the prompt, enable the camera permission for this app in system settings.</string>
    <string name="connection_scanner_permission_request_action">Grant camera access</string>
    <string name="connection_scanner_permission_pending_headline">Waiting for the camera permission</string>
    <string name="connection_scanner_permission_pending_detail">Android is asking for the camera permission. Once it is granted the viewfinder opens here.</string>

    <string name="connection_ticket_heading">Pairing ticket</string>
    <string name="connection_ticket_host_label">Host</string>
    <string name="connection_ticket_port_label">Port</string>
    <string name="connection_ticket_protocol_version_label">Ticket protocol version</string>
    <string name="connection_ticket_expires_at_label">Valid until</string>
    <string name="connection_ticket_absent_headline">No ticket scanned yet</string>
    <string name="connection_ticket_absent_detail">Nothing has been scanned on this device, so there is no address, port or one-time code to pair with yet.</string>

    <string name="connection_ticket_rejection_undecodable_headline">That QR code is not a pairing ticket</string>
    <string name="connection_ticket_rejection_undecodable_detail">The code was read, but its content does not match the pairing-ticket contract. Scan the code shown in the Burp Remote tab of the extension.</string>
    <string name="connection_ticket_rejection_expired_headline">This ticket has already expired</string>
    <string name="connection_ticket_rejection_expired_detail">It was valid until %1$s. Generate a new code in the extension and scan it.</string>
    <string name="connection_ticket_rejection_protocol_headline">Protocol version not supported</string>
    <string name="connection_ticket_rejection_protocol_detail">The ticket declares protocol version %1$d; this client speaks version %2$d. Update whichever side is older and generate a new code.</string>

    <string name="connection_manual_pairing_heading">Enter the pairing text by hand</string>
    <string name="connection_manual_pairing_headline">Fallback when the code cannot be scanned</string>
    <string name="connection_manual_pairing_hint">Paste the pairing text the extension shows next to the QR code. It goes through exactly the same pipeline as a scanned code, so both routes end in the same pairing request.</string>
    <string name="connection_manual_pairing_text_label">Pairing text</string>
    <string name="connection_manual_pairing_action">Pair</string>
    <string name="connection_pairing_text_required_hint">Paste or type the pairing text first</string>

    <string name="connection_pairing_result_heading">Pairing result</string>
    <string name="connection_pairing_succeeded_headline">The plug-in accepted this device</string>
    <string name="connection_pairing_succeeded_detail">The credential is stored on this device. Connection can now continue in the background.</string>
    <string name="connection_pairing_rejection_code">the pairing code did not match the one the plug-in issued</string>
    <string name="connection_pairing_rejection_session_expired">the pairing session already expired; generate a new code</string>
    <string name="connection_pairing_rejection_session_unavailable">the plug-in does not know this pairing session any more; scan a fresh code</string>
    <string name="connection_pairing_rejection_protocol">the two sides disagree on the protocol version</string>
    <string name="connection_pairing_rejection_authentication">this device identity was refused</string>
    <string name="connection_pairing_rejection_unreachable">the plug-in could not be reached; check the address, the port and that Burp is running</string>
    <string name="connection_pairing_rejection_not_supported">the plug-in has not implemented this endpoint yet</string>
    <string name="connection_pairing_rejection_unknown">the plug-in answered with a failure this client does not recognise</string>
    <string name="connection_pairing_in_flight">Pairing…</string>

