    <string name="connection_scan_heading">Scan pairing code</string>
    <string name="connection_scan_headline">Point the camera at the QR code</string>
    <string name="connection_scan_detail">Generate the code in the Burp Remote tab of the extension, then scan it. The code carries the address, the port and a one-time pairing code, so it is the only way to configure this device.</string>
    <string name="connection_scan_action">Open scanner</string>

