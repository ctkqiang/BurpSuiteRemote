    <string name="connection_pairing_rejection_protocol">хоёр тал протоколын хувилбар дээр санал нийлэхгүй байна</string>
    <string name="connection_pairing_rejection_authentication">энэ төхөөрөмжийн таних мэдээлэл татгалзсан</string>
    <string name="connection_pairing_rejection_unreachable">плагинтай холбогдох боломжгүй; хаяг, порт, Burp ажиллаж байгаа эсэхийг шалгана уу</string>
    <string name="connection_pairing_rejection_not_supported">плагин энэ эцсийн цэгийг хараахан хэрэгжүүлээгүй</string>
