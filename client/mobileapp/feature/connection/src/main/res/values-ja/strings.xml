    <string name="connection_endpoint_save_action">保存</string>

    <string name="connection_retry_heading">接続</string>
    <string name="connection_retry_headline">Burp へのセッションを開く</string>
    <string name="connection_retry_detail">接続するとセッションが開いたままになり、イベントがローカルジャーナルへ流れ込みます。ダッシュボードで下に引っ張るか、失敗後にここで再試行してください。</string>
    <string name="connection_retry_action">接続を再試行</string>
    <string name="connection_retry_disabled_hint">まずアドレスとポートを保存してください</string>
