    <string name="settings_theme_heading">Design</string>
    <string name="settings_theme_headline">Diese Wahl gilt überall</string>
    <string name="settings_theme_detail">Jede Ansicht, jede Liste und jedes Label bezieht die Farben aus dem Design; ein Wechsel hier färbt die App sofort um. Die Wahl wird auf diesem Gerät gespeichert.</string>
    <string name="settings_theme_selected">Ausgewählt</string>

    <string name="settings_theme_automatic">Systemeinstellung folgen</string>
    <string name="settings_theme_automatic_detail">Hell, solange das System hell ist, dunkel, solange es dunkel ist — auch wenn das System selbst umschaltet.</string>
    <string name="settings_theme_light">Hell</string>
    <string name="settings_theme_light_detail">Behält die hellen Farben auch bei dunklem System. Draußen nützlich.</string>
    <string name="settings_theme_dark">Dunkel</string>
    <string name="settings_theme_dark_detail">Behält die dunklen Farben auch bei hellem System. Nachts angenehmer für die Augen.</string>

    <string name="settings_language_title">Sprache</string>
    <string name="settings_language_subtitle">Sprache aller Ansichten und Meldungen</string>
    <string name="settings_language_heading">Sprache der Oberfläche</string>
    <string name="settings_language_headline">Ein Wechsel baut die Oberfläche neu auf</string>
    <string name="settings_language_detail">Jeder sichtbare Text stammt aus den Ressourcen der gewählten Sprache, daher wird die Oberfläche beim Wechsel einmal neu aufgebaut. Gespeicherte Daten bleiben unberührt.</string>
    <string name="settings_language_selected">Ausgewählt</string>
