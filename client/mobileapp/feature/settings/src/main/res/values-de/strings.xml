    <string name="settings_security_title">Sicherheit</string>
    <string name="settings_security_subtitle">Was dieser Client nicht tut</string>
    <string name="settings_security_redaction_heading">Redaktion</string>
    <string name="settings_security_redaction_headline">Nur beim Export maskiert</string>
    <string name="settings_security_redaction_body">Sensible Werte werden nur in exportierten Kopien maskiert. Das archivierte Original wird nie überschrieben.</string>
    <string name="settings_security_logging_heading">Protokollierung</string>
    <string name="settings_security_logging_headline">Rümpfe und Credentials bleiben draußen</string>
    <string name="settings_security_logging_body">Anfrage- und Antwortrümpfe, Cookies, Authorization-Header und Token landen nie im Protokoll. Technische Protokolle enthalten nur Bezeichner, Zählwerte und Fehlernamen.</string>
    <string name="settings_security_pairing_heading">Kopplung</string>
    <string name="settings_security_pairing_headline">Keine Steuerung ohne gekoppeltes Gerät</string>
    <string name="settings_security_pairing_body">Bevor ein Steuerbefehl akzeptiert wird, muss das Gerät gekoppelt sein. Das lokale Netz gilt als nicht vertrauenswürdig.</string>
    <string name="settings_security_reason_heading">Was noch nicht einstellbar ist</string>
    <string name="settings_security_reason">konfigurierbare Redaktionsvorgaben brauchen einen Port, den es noch nicht gibt</string>

    <string name="settings_storage_title">Speicher</string>
    <string name="settings_storage_subtitle">Wo lokale Daten liegen und was das Gerät verlässt</string>
    <string name="settings_storage_database_heading">Lokale Datenbank</string>
    <string name="settings_storage_database_headline">Privat für diese Anwendung</string>
    <string name="settings_storage_database_body">Ereignisjournal und Projektionen liegen im privaten Speicher dieser App. In gemeinsamen Speicher wird nichts geschrieben.</string>
    <string name="settings_storage_export_heading">Exporte</string>
    <string name="settings_storage_export_headline">Nur an den gewählten Ort</string>
    <string name="settings_storage_export_body">Exportpakete werden nur an den im Systemdialog gewählten Ort geschrieben; diese App behält keine zweite Kopie.</string>
    <string name="settings_storage_maintenance_heading">Wartung</string>
    <string name="settings_storage_reason_heading">Was noch nicht möglich ist</string>
    <string name="settings_storage_reason">Löschen und Migrieren lokaler Daten brauchen Speicher-Ports, die es noch nicht gibt</string>

