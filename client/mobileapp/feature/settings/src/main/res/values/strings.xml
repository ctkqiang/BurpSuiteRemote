    <string name="settings_appearance_title">Appearance</string>
    <string name="settings_appearance_subtitle">Colour scheme of the whole application</string>

    <string name="settings_theme_heading">Theme</string>
    <string name="settings_theme_headline">This choice applies everywhere</string>
    <string name="settings_theme_detail">Every screen, list and pill takes its colours from the theme, so switching here re-colours the app at once. The choice is stored on this device.</string>
    <string name="settings_theme_selected">Selected</string>

    <string name="settings_theme_automatic">Follow system</string>
    <string name="settings_theme_automatic_detail">Light while the system is in light mode and dark while it is in dark mode, including when the system switches on its own schedule.</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_light_detail">Keeps the light colours even when the system is dark. Useful outdoors.</string>
    <string name="settings_theme_dark">Dark</string>
    <string name="settings_theme_dark_detail">Keeps the dark colours even when the system is light. Softer on the eyes at night.</string>

    <string name="settings_language_title">Language</string>
    <string name="settings_language_subtitle">Language of every screen and message</string>
    <string name="settings_language_heading">Interface language</string>
    <string name="settings_language_headline">Changing this restarts the interface</string>
    <string name="settings_language_detail">Every visible string comes from the resources of the chosen language, so the interface is rebuilt once when you switch. Saved data is not touched.</string>
    <string name="settings_language_selected">Selected</string>
