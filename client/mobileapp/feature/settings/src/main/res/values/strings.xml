    <string name="settings_security_title">Security</string>
    <string name="settings_security_subtitle">What this client refuses to do</string>
    <string name="settings_security_redaction_heading">Redaction</string>
    <string name="settings_security_redaction_headline">Masked on export only</string>
    <string name="settings_security_redaction_body">Sensitive values are masked in exported copies only. The archived original is never rewritten.</string>
    <string name="settings_security_logging_heading">Logging</string>
    <string name="settings_security_logging_headline">Bodies and credentials stay out of the log</string>
    <string name="settings_security_logging_body">Request and response bodies, cookies, Authorization headers and tokens are never written to the log. Technical logs carry identifiers, counts and failure names only.</string>
    <string name="settings_security_pairing_heading">Pairing</string>
    <string name="settings_security_pairing_headline">No control without a paired device</string>
    <string name="settings_security_pairing_body">A device must be paired before any control command is accepted. The local network is treated as untrusted.</string>
    <string name="settings_security_reason_heading">What cannot be configured yet</string>
    <string name="settings_security_reason">configurable redaction defaults need a settings port that does not exist yet</string>

    <string name="settings_storage_title">Storage</string>
    <string name="settings_storage_subtitle">Where local data lives and what leaves it</string>
    <string name="settings_storage_database_heading">Local database</string>
    <string name="settings_storage_database_headline">Private to this application</string>
    <string name="settings_storage_database_body">The event journal and its projections live in the private storage of this application. Nothing is written to shared storage.</string>
    <string name="settings_storage_export_heading">Exports</string>
    <string name="settings_storage_export_headline">Only where you point the file picker</string>
    <string name="settings_storage_export_body">Export bundles are written only to the location you pick in the system file picker; this app keeps no second copy.</string>
    <string name="settings_storage_maintenance_heading">Maintenance</string>
    <string name="settings_storage_reason_heading">What cannot be done yet</string>
    <string name="settings_storage_reason">clearing and migrating local data need storage ports that do not exist yet</string>

