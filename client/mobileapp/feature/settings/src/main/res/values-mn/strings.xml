    <string name="settings_security_title">Аюулгүй байдал</string>
    <string name="settings_security_subtitle">Энэ клиент юуг хийхээс татгалздаг</string>
    <string name="settings_security_redaction_heading">Дархлал</string>
    <string name="settings_security_redaction_headline">Зөвхөн экспортод масклана</string>
    <string name="settings_security_redaction_body">Эмзэг утгууд зөвхөн экспортлогдсон хуулбарт масклагдана. Хадгалагдсан эх хувилбар дахин бичигдэхгүй.</string>
    <string name="settings_security_logging_heading">Бүртгэл</string>
    <string name="settings_security_logging_headline">Бие болон эрх олголт логт ордоггүй</string>
    <string name="settings_security_logging_body">Хүсэлт ба хариуны бие, Cookie, Authorization толгой, токен хэзээ ч логт бичигдэхгүй. Техникийн логт зөвхөн тодорхойлогч, тоо, алдааны нэр орно.</string>
    <string name="settings_security_pairing_heading">Хослолт</string>
    <string name="settings_security_pairing_headline">Хослогдсон төхөөрөмжгүйгээр удирдлага байхгүй</string>
    <string name="settings_security_pairing_body">Удирдлагын команд хүлээн авахад төхөөрөмж хослогдсон байх ёстой. Локал сүлжээг итгэж болохгүй гэж үзнэ.</string>
    <string name="settings_security_reason_heading">Одоогоор тохируулж болохгүй зүйл</string>
    <string name="settings_security_reason">тохируулж болох дархлалын анхдагч утгад хараахан байхгүй тохиргооны порт хэрэгтэй</string>

    <string name="settings_storage_title">Хадгалах сан</string>
    <string name="settings_storage_subtitle">Локал өгөгдөл хаана байдаг, түүнээс юу гардаг</string>
    <string name="settings_storage_database_heading">Локал өгөгдлийн сан</string>
    <string name="settings_storage_database_headline">Энэ аппад хувийн</string>
    <string name="settings_storage_database_body">Үйл явдлын журнал болон түүний проекц энэ аппын хувийн хадгалах санд хадгалагдана. Нийтлэг хадгалах санд юу ч бичигдэхгүй.</string>
    <string name="settings_storage_export_heading">Экспортууд</string>
    <string name="settings_storage_export_headline">Зөвхөн файл сонгогчоор заасан газар</string>
    <string name="settings_storage_export_body">Экспортын багц зөвхөн системийн файл сонгогчоор сонгосон байршилд бичигдэнэ; энэ апп хоёр дахь хуулбарыг хадгалахгүй.</string>
    <string name="settings_storage_maintenance_heading">Засвар үйлчилгээ</string>
    <string name="settings_storage_reason_heading">Одоогоор хийж болохгүй зүйл</string>
    <string name="settings_storage_reason">локал өгөгдлийг устгах, шилжүүлэхэд хараахан байхгүй хадгалах сангийн портууд хэрэгтэй</string>

