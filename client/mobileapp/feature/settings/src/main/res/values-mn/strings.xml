    <string name="settings_theme_heading">Сэдэв</string>
    <string name="settings_theme_headline">Энэ сонголт хаа сайгүй хамаарна</string>
    <string name="settings_theme_detail">Дэлгэц, жагсаалт, тэмдэг бүр сэдвээс өнгөө авдаг тул энд шилжүүлэхэд апп бүхэлдээ нэг дор дахин өнгөждөг. Сонголт энэ төхөөрөмжид хадгалагдана.</string>
    <string name="settings_theme_selected">Сонгогдсон</string>

    <string name="settings_theme_automatic">Системийг дагах</string>
    <string name="settings_theme_automatic_detail">Систем цайвар үед цайвар, бараан үед бараан. Систем өөрийн хуваариар шилжихэд ч дагана.</string>
    <string name="settings_theme_light">Цайвар</string>
    <string name="settings_theme_light_detail">Систем бараан ч цайвар өнгийг хадгална. Гадаа ашиглахад тохиромжтой.</string>
    <string name="settings_theme_dark">Бараан</string>
    <string name="settings_theme_dark_detail">Систем цайвар ч бараан өнгийг хадгална. Шөнө нүдэнд зөөлөн.</string>

    <string name="settings_language_title">Хэл</string>
    <string name="settings_language_subtitle">Дэлгэц болон мессеж бүрийн хэл</string>
    <string name="settings_language_heading">Интерфейсийн хэл</string>
    <string name="settings_language_headline">Үүнийг өөрчлөхөд интерфейс дахин асна</string>
    <string name="settings_language_detail">Харагдах мөр бүр сонгосон хэлний нөөцөөс авдаг тул шилжүүлэхэд интерфейс нэг удаа дахин бүтээгдэнэ. Хадгалсан өгөгдөлд нөлөөлөхгүй.</string>
    <string name="settings_language_selected">Сонгогдсон</string>
