    <string name="settings_security_title">セキュリティ</string>
    <string name="settings_security_subtitle">このクライアントが拒否すること</string>
    <string name="settings_security_redaction_heading">墨消し</string>
    <string name="settings_security_redaction_headline">エクスポート時のみマスク</string>
    <string name="settings_security_redaction_body">機密値はエクスポートされたコピーでのみマスクされます。保存された元データが書き換えられることはありません。</string>
    <string name="settings_security_logging_heading">ログ記録</string>
    <string name="settings_security_logging_headline">本文と認証情報はログに残しません</string>
    <string name="settings_security_logging_body">リクエストとレスポンスの本文、Cookie、Authorization ヘッダー、トークンはログに記録されません。技術ログには識別子、件数、失敗名だけが記録されます。</string>
    <string name="settings_security_pairing_heading">ペアリング</string>
    <string name="settings_security_pairing_headline">ペアリング済み端末がなければ制御できません</string>
    <string name="settings_security_pairing_body">制御コマンドを受け付けるには、端末がペアリング済みである必要があります。ローカルネットワークは信頼されないものとして扱われます。</string>
    <string name="settings_security_reason_heading">まだ設定できないもの</string>
    <string name="settings_security_reason">設定可能な墨消しの既定値には、まだ存在しない設定ポートが必要です</string>

    <string name="settings_storage_title">ストレージ</string>
    <string name="settings_storage_subtitle">ローカルデータの保存場所と、そこから出ていくもの</string>
    <string name="settings_storage_database_heading">ローカルデータベース</string>
    <string name="settings_storage_database_headline">このアプリ専用</string>
    <string name="settings_storage_database_body">イベントジャーナルとその投影は、このアプリのプライベートストレージに保存されます。共有ストレージには何も書き込まれません。</string>
    <string name="settings_storage_export_heading">エクスポート</string>
    <string name="settings_storage_export_headline">ファイルピッカーで指定した場所だけ</string>
    <string name="settings_storage_export_body">エクスポートバンドルは、システムのファイルピッカーで選んだ場所にだけ書き込まれます。このアプリは二つ目のコピーを保持しません。</string>
    <string name="settings_storage_maintenance_heading">メンテナンス</string>
    <string name="settings_storage_reason_heading">まだできないこと</string>
    <string name="settings_storage_reason">ローカルデータの消去と移行には、まだ存在しないストレージポートが必要です</string>

