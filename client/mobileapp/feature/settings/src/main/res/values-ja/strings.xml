    <string name="settings_appearance_title">外観</string>
    <string name="settings_appearance_subtitle">アプリ全体の配色</string>

    <string name="settings_theme_heading">テーマ</string>
    <string name="settings_theme_headline">この選択はすべての場所に適用されます</string>
    <string name="settings_theme_detail">すべての画面、リスト、ピルがテーマから色を取るため、ここで切り替えるとアプリ全体が一度に再配色されます。選択はこの端末に保存されます。</string>
    <string name="settings_theme_selected">選択中</string>

    <string name="settings_theme_automatic">システムに従う</string>
    <string name="settings_theme_automatic_detail">システムがライトの間はライト、ダークの間はダーク。システムが自らのスケジュールで切り替えるときも追従します。</string>
    <string name="settings_theme_light">ライト</string>
    <string name="settings_theme_light_detail">システムがダークでもライト配色を維持します。屋外で便利です。</string>
    <string name="settings_theme_dark">ダーク</string>
    <string name="settings_theme_dark_detail">システムがライトでもダーク配色を維持します。夜は目にやさしくなります。</string>

    <string name="settings_flavor_heading">カラーフレーバー</string>
    <string name="settings_flavor_headline">8種類のパレット、同じレイアウト</string>
    <string name="settings_flavor_detail">アクセントカラーと全体の色合いだけが変わり、構造は同じです。各フレーバーにライト版とダーク版があり、上のテーマに従います。</string>
    <string name="settings_flavor_selected">選択中</string>

    <string name="settings_flavor_burp_classic">Burp クラシック</string>
    <string name="settings_flavor_cyber_cyan">サイバーシアン</string>
    <string name="settings_flavor_forest_emerald">フォレストエメラルド</string>
    <string name="settings_flavor_royal_violet">ロイヤルバイオレット</string>
    <string name="settings_flavor_rose_gold">ローズゴールド</string>
    <string name="settings_flavor_ocean_blue">オーシャンブルー</string>
    <string name="settings_flavor_solar_amber">ソーラーアンバー</string>
    <string name="settings_flavor_monochrome">モノクローム</string>

    <string name="settings_language_title">言語</string>
    <string name="settings_language_subtitle">すべての画面とメッセージの言語</string>
    <string name="settings_language_heading">インターフェース言語</string>
    <string name="settings_language_headline">変更するとインターフェースが再起動します</string>
    <string name="settings_language_detail">表示されるすべての文字列は選択した言語のリソースから取得されるため、切り替えるとインターフェースが一度再構築されます。保存済みデータには触れません。</string>
    <string name="settings_language_selected">選択中</string>
    <!-- 语言名按各自的语言书写，三种语言里都一样。 -->
